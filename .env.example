# Date: 2026-11-02
# Description: Environment variable template for Apex iOS development environment

# Node & Fastify Environment
NODE_ENV=development
PORT=8000
HOST=0.0.0.0
API_HOST_PORT=8003

# PostgreSQL Configuration
POSTGRES_USER=apex_user
POSTGRES_PASSWORD=apex_password
POSTGRES_DB=apex_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql://apex_user:apex_password@postgres:5432/apex_db?schema=public

# Mobile App Configuration
EXPO_PUBLIC_API_URL=http://localhost:8003
